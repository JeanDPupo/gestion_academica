# ─────────────────────────────────────────────────────────────────────
# Variables de entorno del proyecto.
# Copiar a ".env" (cp .env.example .env) y ajustar si hace falta.
# docker-compose.yml funciona sin el archivo .env: usa estos mismos
# valores por defecto.
# ─────────────────────────────────────────────────────────────────────

# Secreto con el que las Lambdas firman los tokens de sesión.
# Cambiarlo invalida todas las sesiones abiertas.
TOKEN_SECRET=solo-para-desarrollo-local

# Duración de la sesión en segundos (TTL de la clave sesion:<jti> en Redis)
SESION_TTL=3600

# TTL en segundos de las respuestas que muestran cupos (catálogo, detalle
# de curso, ofertas de un profesor). Más alto = menos lecturas a DynamoDB
# y cupos mostrados con más atraso.
TTL_CUPOS=15

# Puertos publicados en la máquina (cambiar si ya están ocupados)
PUERTO_EMULADOR=4566
PUERTO_REDIS=6379
PUERTO_FRONTEND=8080
